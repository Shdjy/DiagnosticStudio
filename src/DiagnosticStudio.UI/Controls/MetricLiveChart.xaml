<UserControl x:Class="DiagnosticStudio.UI.Controls.MetricLiveChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="600">
    <Grid Background="#1A1A20">
        <Border BorderBrush="#3D3D4E" BorderThickness="1" CornerRadius="6">
            <Canvas x:Name="ChartCanvas" ClipToBounds="True" Background="Transparent" SizeChanged="ChartCanvas_SizeChanged"/>
        </Border>
        
        <!-- 图表头部标题与即时值 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8">
            <TextBlock x:Name="TitleText" Text="私有内存 (Private Bytes)" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
            <TextBlock x:Name="CurrentValueText" Text="-- MB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
