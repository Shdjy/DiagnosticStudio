<UserControl x:Class="DiagnosticStudio.UI.Controls.SourceCodeViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="CodeLineListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{Binding BackgroundBrush}" 
                                BorderBrush="{Binding BorderBrush}" 
                                BorderThickness="{Binding BorderThickness}"
                                ToolTip="{Binding TooltipText}"
                                SnapsToDevicePixels="True"
                                Padding="4,2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="#1E1E24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏与路径展示 -->
        <Border Grid.Row="0" Background="#2B2B36" BorderBrush="#3D3D4E" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄 源码定位: " FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="{Binding CurrentFilePath, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                               Foreground="#E2E8F0" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="4,0">
                        <TextBlock Text="🔴 崩溃致命点" Foreground="#EF4444" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#33EAB308" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="4,0">
                        <TextBlock Text="🟡 业务入口/上下文" Foreground="#EAB308" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 代码行列表 -->
        <ListBox x:Name="LinesListBox" 
                 Grid.Row="1"
                 ItemsSource="{Binding CodeLines, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 ItemContainerStyle="{StaticResource CodeLineListBoxItemStyle}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="#1E1E24"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 行号列 -->
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding LineNumber}" 
                                   Foreground="#64748B" 
                                   FontFamily="Consolas" 
                                   FontSize="12" 
                                   TextAlignment="Right" 
                                   Padding="0,0,12,0"/>

                        <!-- 代码文本 -->
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Content}" 
                                   Foreground="{Binding TextColorBrush}" 
                                   FontFamily="Consolas" 
                                   FontSize="13"/>

                        <!-- 风险标记徽章 -->
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding BadgeText}" 
                                   Foreground="{Binding BadgeColorBrush}" 
                                   FontWeight="Bold" 
                                   FontSize="11" 
                                   Margin="16,0,8,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
